{
  "name": "lattrapereves",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name lattrapereves",
    "dev:sandbox": "wrangler pages dev dist --d1=lattrapereves-db --r2=IMAGES --local --ip 0.0.0.0 --port 3000",
    "db:migrate:local": "wrangler d1 migrations apply lattrapereves-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply lattrapereves-db",
    "db:seed": "wrangler d1 execute lattrapereves-db --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.7.6",
    "@hono/vite-cloudflare-pages": "^0.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250705.0",
    "serve": "^14.2.5",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^3.108.0"
  }
}
